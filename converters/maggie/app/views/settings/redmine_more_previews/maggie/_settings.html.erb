<p><%= l(:"redmine_more_previews.maggie.text_explanation") %></p>
<p>
  <label><%= l(:label_resample) %></label>
  <%= select_tag "settings[converter][maggie][density]", options_for_select(Maggie::DENSITIES, settings['density']) %>
</p>
<% Maggie::SIZE_LIMITS.each_key do |key| %>
<p>
  <label><%= l(:"redmine_more_previews.maggie.label_#{key}") %></label>
  <%= number_field_tag "settings[converter][maggie][#{key}]", Maggie.size_limit(settings, key), :min => 1, :size => 8 %>
</p>
<% end %>
<p><em class="info"><%= l(:"redmine_more_previews.maggie.text_help_limits") %></em></p>
<%# whether the ImageMagick program Redmine runs has the coder of each format;
    the icon as the status lines of the settings draw it (Redmine 7: SVG sprites) %>
<% Maggie::IMAGE_FORMATS.each_value do |format| %>
<% readable = RedmineMorePreviews.imagemagick_reads?(format[:coder]) %>
<p><%= format[:label] %> (<%= File.basename(RedmineMorePreviews.convert_bin.to_s) %>) <span class="icon-only <%= readable ? 'icon-ok' : 'icon-error' %>"><%= sprite_icon(readable ? 'checked' : 'warning') %></span></p>
<% end %>
