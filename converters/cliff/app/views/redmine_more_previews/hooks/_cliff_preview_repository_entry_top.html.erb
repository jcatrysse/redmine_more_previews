<%-if RedmineMorePreviews::Converter.responsible( entry.name, :pathonly => true )&.id == :cliff %>
  
  <% html_id = SecureRandom.uuid.to_s
    js = "$('##{html_id}-show, ##{html_id}-hide').toggle(); $('##{html_id}').fadeToggle(150);"
    toggler = ''.html_safe
    toggler << link_to_function("...", js, :id => "#{html_id}-show", :class => 'collapsible collapsed')
    toggler << link_to_function(" x", js, :id => "#{html_id}-hide", :class => 'collapsible', :style => 'display:none;')
  %>
  
  <%# converted while the page is rendered: no free conversion slot, or an email
      beyond the limits, leaves the boxes out instead of turning the page into a 503
      or 413 (the preview frame below answers for itself) %>
  <%- begin %>
  <%# the stored conversion is read, as the preview frame reads it; a block
      given to more_asset converts the email again, for every view of the page.
      That is done only where nothing current can be read: an administrator's
      reload or unsafe view, the cache off or full, or the headers stored in
      another language (port of curecodejp d6a2029) %>
  <%  names   = %w(headers.html fields.html attachments.html)
      reload  = params[:reload].present? && User.current.admin?
      unsafe  = params[:unsafe].present? && User.current.admin?
      cached  = RedmineMorePreviews::Converter.cache_previews?
      current = cached && RedmineMorePreviews::Conversion.current_cached_preview?( repository.preview_filepath(path, rev), :cliff )
      if cached && !reload && !unsafe &&
         ( current ? Cliff.cache_locale_matches?( repository.preview_filepath(path, rev), I18n.locale ) : !RedmineMorePreviews::Lib::RmpCacheSize.full? )
        # a preview not stored yet is converted by the first name, once
        fragments = names.map {|name| repository.more_asset( path, rev, :asset => name ) }
      else
        # one conversion, not stored: the preview, the asset (none), the three names
        fragments = repository.more_asset( path, rev, :assets => names, :reload => reload ) {|_html, _asset, *data| data }
      end
      # a fragment over the inline limit is the marker: a notice in its place,
      # the email and the other fragments stay (port of curecodejp ebe0641, #63)
      too_large = Array( fragments ).map {|fragment| fragment == RedmineMorePreviews::Conversion::CLIFF_FRAGMENT_TOO_LARGE }
      email_headers, email_fields, email_attachments = fragments
  %>
  
    <% if too_large[0] %>
      <p class="nodata"><%= l(:text_more_previews_inline_too_large) %></p>
    <% elsif email_headers %>
      <div class="box"><%= more_previews_inline(email_headers) %></div>
    <%- end %>
    
    <% if too_large[1] %>
      <p class="nodata"><%= l(:text_more_previews_inline_too_large) %></p>
    <% elsif email_fields %>
      <%= toggler.html_safe %>
      <div class="box" id="<%= html_id %>" style="display:none;"><%= more_previews_inline(email_fields) %></div>
    <%- end %>
    
    <% if too_large[2] %>
      <p class="nodata"><%= l(:text_more_previews_inline_too_large) %></p>
    <% elsif email_attachments %>
      <div class="box"><%= more_previews_inline(email_attachments) %></div>
    <%- end %>
    
  <%- rescue RedmineMorePreviews::Exceptions::ConverterLockTimeOut %>
  <%- rescue RedmineMorePreviews::Exceptions::ConverterTooLarge => e %>
    <%# the preview frame below answers 413, which browsers do not show in an
        object frame: the page says why %>
    <p class="warning"><%= e.is_a?(RedmineMorePreviews::Exceptions::ConverterRefused) ? e.message : l(:text_more_previews_too_large) %></p>
  <%- end %>
  
<% end %>
